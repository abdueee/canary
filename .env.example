# Copy to .env and fill in. Never commit .env.
#   PowerShell: Copy-Item .env.example .env      (copy it; don't rename this file)

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://canary:canary@localhost:5433/canary

# Better Auth
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# DigitalOcean Spaces (checked the first time storage is used)
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=tor1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# Seed: this account is promoted to admin by `npm run db:seed` (register it first)
SEED_ADMIN_EMAIL=
