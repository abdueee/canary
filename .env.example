# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://canary:canary@localhost:5433/canary

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# DigitalOcean Spaces
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=tor1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# Seed
SEED_ADMIN_EMAIL=
