// Canary data model. See data-and-screens.md for how the tables fit together.
//
// The User, Session, Account and Verification models at the bottom belong to
// Better Auth (authentication). The app's own tables link to User for
// "who created / uploaded / acknowledged / resolved this".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A recurring feed being monitored, e.g. "Weekly Claims".
model Dataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation("DatasetCreatedBy", fields: [createdById], references: [id])
  versions  DatasetVersion[]
  checks    Check[]
  alerts    Alert[]
}

// One uploaded CSV. The file lives in Spaces at `fileKey`.
model DatasetVersion {
  id            String   @id @default(cuid())
  datasetId     String
  versionNumber Int
  fileKey       String
  fileName      String
  sizeBytes     Int
  contentHash   String // sha256 of the file contents
  rowCount      Int? // set after profiling
  profile       Json? // per-column summary, set after profiling
  uploadedById  String
  createdAt     DateTime @default(now())

  dataset    Dataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("VersionUploadedBy", fields: [uploadedById], references: [id])
  runs       CheckRun[]

  @@unique([datasetId, versionNumber])
  @@index([datasetId, createdAt])
}

enum CheckType {
  REQUIRED_COLUMNS
  ROW_COUNT
  NULL_RATE
  ALLOWED_VALUES
  NUMERIC_RANGE
  UNIQUE
}

// One rule for a dataset. `config` shape depends on `type` and is validated with Zod.
// Every check is equally important: any failure fails the run.
model Check {
  id        String    @id @default(cuid())
  datasetId String
  type      CheckType
  column    String? // null for REQUIRED_COLUMNS and ROW_COUNT
  config    Json
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dataset Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results CheckResult[]

  @@index([datasetId])
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
}

enum ResultStatus {
  PASSED
  FAILED
  SKIPPED
  ERROR
}

// One grading of a version against its dataset's enabled checks.
model CheckRun {
  id         String    @id @default(cuid())
  versionId  String
  status     RunStatus @default(QUEUED)
  error      String? // set if the run itself crashed
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  version DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  results CheckResult[]
  alert   Alert?

  @@index([versionId, createdAt])
}

// The grade on one check within a run.
model CheckResult {
  id           String       @id @default(cuid())
  runId        String
  checkId      String
  status       ResultStatus
  message      String
  actual       Json?
  expected     Json?
  failingCount Int?
  sampleRows   Json? // up to 20 { rowNumber, values } objects
  createdAt    DateTime     @default(now())

  run   CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  check Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([runId, checkId]) // the worker upserts, so retries don't duplicate
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// Created when a run ends FAILED or ERROR. At most one per run.
model Alert {
  id               String      @id @default(cuid())
  runId            String      @unique
  datasetId        String
  status           AlertStatus @default(OPEN)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())

  run            CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  acknowledgedBy User?    @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     User?    @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([datasetId])
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth). Field names and table names (@@map) must match
// what Better Auth expects, so change these only together with src/lib/auth.ts.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("viewer") // "admin" | "viewer", see src/lib/roles.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions Session[]
  accounts Account[]

  datasetsCreated    Dataset[]        @relation("DatasetCreatedBy")
  versionsUploaded   DatasetVersion[] @relation("VersionUploadedBy")
  alertsAcknowledged Alert[]          @relation("AlertAcknowledgedBy")
  alertsResolved     Alert[]          @relation("AlertResolvedBy")

  @@index([role])
  @@map("user")
}

// One signed-in browser. The cookie holds `token`; deleting the row signs it out.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// A way of logging in. For email/password, providerId is "credential" and
// `password` holds the hash (never the plain password).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// Short-lived tokens (email verification, password reset). Unused for now.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}
